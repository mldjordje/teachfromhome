POSTGRES_URL=postgres://user:pass@host:5432/dbname?sslmode=require
AUTH_SECRET=replace-with-random-secret
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
# Optional aliases (supported as fallback)
# NEXTAUTH_SECRET=replace-with-random-secret
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token
RESEND_API_KEY=re_xxx
FROM_EMAIL="TeachFromHome <noreply@your-domain.com>"
CRON_SECRET=replace-with-cron-secret

# Optional: comma-separated emails auto-granted admin role on login
# ADMIN_SEED_EMAILS=milos93tutor@gmail.com,web.wise018@gmail.com
